  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614585}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661615024}
  - {fileID: 8926484042661615012}
  - {fileID: 8926484042661614923}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614910}
  m_BlockName: Shade moving water droplets
  m_HLSLCode: "void ShadeSimulatedDetail(inout VFXAttributes attributes, VFXSampler2D MaterialState, float MoteCount, float ReleaseWeight)\n{\n    uint width, height;\n    MaterialState.t.GetDimensions(width, height);\n    uint slot = attributes.particleId % (uint)clamp(MoteCount, 1.0, max(1.0, (float)width));\n    float4 drop = MaterialState.t.Load(int3(slot, 0, 0));\n    float4 flow = MaterialState.t.Load(int3(slot, 1, 0));\n    float speed = length(flow.xy);\n    float2 axis = (speed > .02) ? flow.xy / speed : float2(1.0, 0.0);\n    float seed = saturate(flow.z);\n    float stretch = smoothstep(.35, 4.5, speed);\n    float widthWorld = lerp(.034, .078, seed);\n    float glint = saturate(.32 + .50 * abs(axis.y) + .18 * flow.w);\n    attributes.axisX = float3(axis, 0.0);\n    attributes.axisY = float3(-axis.y, axis.x, 0.0);\n    attributes.axisZ = float3(0.0, 0.0, 1.0);\n    attributes.angleX = 0.0;\n    attributes.angleY = 0.0;\n    attributes.angleZ = 0.0;\n    attributes.pivotX = 0.0;\n    attributes.pivotY = 0.0;\n    attributes.pivotZ = 0.0;\n    attributes.size = 1.0;\n    attributes.scaleX = widthWorld * lerp(1.0, 1.95, stretch);\n    attributes.scaleY = widthWorld * lerp(.93, .66, stretch);\n    attributes.scaleZ = 1.0;\n    attributes.texIndex = flow.w;\n    attributes.age = .16 * speed + .072 * drop.y + .045 * drop.x;\n    attributes.color = lerp(float3(.30, .66, .77), float3(.82, .97, 1.06), glint);\n    attributes.alpha = saturate(drop.w) * saturate(ReleaseWeight) * lerp(.35, .82, stretch);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: ShadeSimulatedDetail
    selectedIndex: 0
