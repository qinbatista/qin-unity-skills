  - {fileID: 8926484042661615023}
  - {fileID: 8926484042661615002}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614995}
  m_BlockName: Read position from liquid solver
  m_HLSLCode: "void ReadSimulatedMotion(inout VFXAttributes attributes, VFXSampler2D MaterialState, float MoteCount)\n{\n    uint width, height;\n    MaterialState.t.GetDimensions(width, height);\n    uint slot = attributes.particleId % (uint)clamp(MoteCount, 1.0, max(1.0, (float)width));\n    float4 drop = MaterialState.t.Load(int3(slot, 0, 0));\n    attributes.position = float3(drop.xy, -.08);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: ReadSimulatedMotion
    selectedIndex: 0
