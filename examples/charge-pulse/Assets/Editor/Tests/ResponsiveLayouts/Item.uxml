<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="tile" class="card tile" focusable="true">
        <ui:VisualElement name="item-identity" class="item-identity" picking-mode="Ignore">
            <ui:Label name="item-icon" class="item-icon" picking-mode="Ignore" />
            <ui:Label name="item-name" class="item-name" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="item-count" class="detail item-count" picking-mode="Ignore" />
        <ui:VisualElement class="tile-frame" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
