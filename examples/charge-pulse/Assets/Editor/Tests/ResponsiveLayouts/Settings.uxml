<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="setting-row" src="SettingRow.uxml" />
    <Style src="Layouts.uss" />
    <Style src="LayoutFeedback.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="safe" class="safe page">
            <ui:Label name="heading" class="title page-title localized" />
            <ui:VisualElement name="settings-groups" class="settings-groups">
                <ui:VisualElement name="display" class="card settings-card">
                    <ui:Label name="display-heading" class="card-title localized" />
                    <ui:Instance template="setting-row" name="display-row" class="setting-row" />
                    <ui:Instance template="setting-row" name="frame-rate-row" class="setting-row" />
                </ui:VisualElement>
                <ui:VisualElement name="audio" class="card settings-card">
                    <ui:Label name="audio-heading" class="card-title localized" />
                    <ui:Instance template="setting-row" name="environment-row" class="setting-row" />
                    <ui:Instance template="setting-row" name="music-row" class="setting-row" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
