<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Layouts.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="safe" class="safe page">
            <ui:VisualElement name="journal" class="journal">
                <ui:VisualElement name="journal-header" class="journal-header">
                    <ui:Label name="heading" class="title localized" />
                    <ui:Label name="entry-count" class="detail" />
                </ui:VisualElement>
                <ui:ScrollView name="quest-scroll" class="quest-scroll card" vertical-scroller-visibility="AlwaysVisible" />
                <ui:Label name="journal-footer" class="journal-footer detail" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
