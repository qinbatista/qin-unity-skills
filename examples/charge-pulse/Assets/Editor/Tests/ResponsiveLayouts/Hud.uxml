<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Layouts.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="safe" class="safe hud-main" picking-mode="Ignore">
            <ui:VisualElement name="objective" class="card hud-objective">
                <ui:Label name="objective-caption" class="caption localized" />
                <ui:Label name="objective-title" class="title localized" />
                <ui:VisualElement name="stamina" class="meter">
                    <ui:VisualElement class="meter-fill" />
                </ui:VisualElement>
                <ui:Label name="stamina-text" class="detail" />
            </ui:VisualElement>
            <ui:VisualElement name="tools" class="hud-tools action-row">
                <ui:Label name="compass" class="status localized" />
                <ui:Label name="elevation" class="status" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="header" class="header" picking-mode="Ignore">
            <ui:Button name="left-wing" class="wing localized" />
            <ui:Label name="center-title" class="hud-title localized" />
            <ui:Button name="right-wing" class="wing localized" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
