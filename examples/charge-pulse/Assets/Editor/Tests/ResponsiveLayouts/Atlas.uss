.atlas-safe { align-items: center; justify-content: center; padding: 14px; }
.atlas { width: 100%; height: 100%; max-width: 940px; max-height: 760px; }
.atlas-header { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; margin-bottom: 10px; }
.atlas-body { flex-grow: 1; min-height: 0; }
.atlas-directory { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.atlas-query { height: 48px; flex-shrink: 0; margin: 3px 0 9px 0; padding: 0; }
.atlas-query .unity-text-input { padding-left: 10px; background-color: #263d4b; color: #f2f2df; font-size: 18px; }
.atlas-list { flex-grow: 1; min-height: 0; background-color: #1d303c; }
.atlas .atlas-row, .atlas-safe .atlas-button {
    -unity-text-align: middle-left;
    background-color: #274451; color: #fff4db; font-size: 18px;
    border-width: 0; border-radius: 5px; margin: 0; padding: 0 12px;
    height: 48px; flex-shrink: 0;
}
.atlas .atlas-row { width: 100%; }
.atlas .atlas-row:focus, .atlas-safe .atlas-button:focus { border-width: 2px; border-color: #eac376; }
.atlas-detail, .atlas-status { padding: 14px; background-color: #233e40; }
.atlas-safe .atlas-name { font-size: 28px; -unity-font-style: bold; margin-top: 12px; }
.atlas .atlas-altitude { color: #a5d9bf; font-size: 22px; margin: 8px 0 20px 0; }
.atlas-status { flex-grow: 1; justify-content: center; align-items: center; }
.atlas-status .atlas-button { margin-top: 10px; }
.atlas-detail { display: none; flex-grow: 1; min-width: 0; }
.detail-open .atlas-directory { visibility: hidden; }
.detail-open .atlas-detail { display: flex; position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.wide-body .atlas-body { flex-direction: row; }
.wide-body .atlas-directory { visibility: visible; }
.wide-body .atlas-detail { position: relative; left: auto; right: auto; top: auto; bottom: auto; display: flex; flex-basis: 0; margin-left: 16px; }
.wide-body #return-list { display: none; }

.sort-shade { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: flex-end; background-color: rgba(8, 17, 22, .72); }
.sort-sheet { width: 100%; padding: 14px; background-color: #263f47; }
.sort-sheet .atlas-button { margin-top: 8px; }
.wide-body .sort-shade { flex-direction: row; }
.wide-body .sort-sheet { width: 270px; justify-content: center; }
