<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Layouts.uss" />
    <Style src="LayoutFeedback.uss" />
    <ui:VisualElement name="screen" class="screen dialog-screen">
        <ui:VisualElement name="safe" class="safe page">
            <ui:VisualElement name="dialog" class="dialog">
                <ui:Label name="heading" class="dialog-heading localized" />
                <ui:Label name="message" class="dialog-message localized" />
                <ui:VisualElement name="actions" class="dialog-actions action-row">
                    <ui:Button name="stay" class="dialog-button secondary localized" />
                    <ui:Button name="leave" class="dialog-button primary localized" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
