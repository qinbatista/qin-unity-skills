.screen {
    flex-grow: 1;
    background-color: #131e2b;
}

.safe, .header, .cutout {
    position: absolute;
}

.page, .hud-main {
    align-items: center;
    justify-content: center;
}

.screen Label {
    margin: 0;
    padding: 0;
    color: #f0ece3;
    font-size: 20px;
    -unity-text-align: middle-left;
}

.screen .title {
    color: #fbf5e7;
    font-size: 36px;
    -unity-font-style: bold;
}

.screen .detail {
    color: #bccad5;
    font-size: 18px;
}

.screen .caption {
    color: #efc681;
}

.screen .page-title, .screen .page-subtitle {
    -unity-text-align: middle-center;
}

.screen .page-subtitle {
    margin-top: 4px;
    margin-bottom: 18px;
}

.card {
    background-color: #213243;
    border-radius: 14px;
}

.action-row, .setting-row, .item-identity {
    flex-direction: row;
    align-items: center;
}

.header {
    height: 120px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.screen .wing, .screen .hud-title {
    flex-shrink: 0;
    width: 124px;
    height: 48px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: #213243;
    border-radius: 12px;
    color: #f0ece3;
    font-size: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.screen .hud-title {
    width: 196px;
    flex-shrink: 1;
    background-color: transparent;
    font-size: 26px;
}

.cutout {
    background-color: #05080d;
    border-radius: 18px;
}

.hud-objective {
    align-items: flex-start;
    width: 352px;
    max-width: 96%;
    padding: 24px;
}

.screen .hud-objective .title {
    font-size: 30px;
}

.meter {
    width: 100%;
    height: 8px;
    margin-top: 18px;
    margin-bottom: 8px;
    border-radius: 4px;
    background-color: #111a24;
}

.meter-fill {
    width: 72%;
    height: 100%;
    border-radius: 4px;
    background-color: #efc681;
}

.hud-tools {
    position: absolute;
    bottom: 22px;
    justify-content: center;
}

.screen .status {
    width: 174px;
    height: 44px;
    margin: 6px;
    border-radius: 12px;
    background-color: #213243;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.tiles {
    /* Leave room for rounded item widths and margins at fractional panel scales. */
    width: 352px;
    max-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.wide-body .tiles {
    width: 526px;
}

.tile {
    width: 162px;
    height: 104px;
    margin: 6px;
    padding: 12px;
    justify-content: center;
}

.item-identity {
    justify-content: center;
}

.screen .item-icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    border-radius: 7px;
    background-color: #3a5263;
    color: #f8d99b;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.screen .item-name {
    font-size: 17px;
}

.screen .item-count {
    margin-top: 7px;
    -unity-text-align: middle-center;
}

.settings-groups {
    align-items: center;
    margin-top: 18px;
}

.wide-body .settings-groups {
    flex-direction: row;
}

.settings-card {
    width: 284px;
    height: 154px;
    margin: 7px;
    padding: 18px;
}

.screen .card-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.setting-row {
    height: 36px;
    justify-content: space-between;
}

.screen .value {
    width: 52px;
    color: #f5d39a;
    -unity-text-align: middle-right;
}

.dialog-screen {
    background-color: #101821;
}

.dialog {
    width: 400px;
    max-width: 96%;
    height: 204px;
    background-color: #25384a;
    align-items: center;
}

.screen .dialog-heading, .screen .dialog-message {
    width: 352px;
    max-width: 95%;
    height: 44px;
    -unity-text-align: middle-center;
}

.screen .dialog-heading {
    margin-top: 14px;
    font-size: 32px;
    -unity-font-style: bold;
}

.screen .dialog-message {
    color: #bccad5;
}

.dialog-actions {
    width: 100%;
    max-width: 336px;
    height: 48px;
    margin-top: 28px;
    justify-content: center;
}

.dialog-button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    max-width: 152px;
    min-width: 0;
    height: 48px;
    margin: 0 8px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.secondary {
    background-color: #3a5263;
    color: #f0ece3;
}

.primary {
    background-color: #efc681;
    color: #131e2b;
}

.journal {
    width: 416px;
    max-width: 94%;
    height: 640px;
    max-height: 96%;
}

.short-body .journal {
    width: 496px;
    height: 386px;
}

.journal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.screen .journal-header #entry-count {
    margin-left: 12px;
}

.quest-scroll {
    flex-grow: 1;
    padding: 8px 12px;
    overflow: hidden;
}

.screen .quest-row {
    height: 52px;
    padding-left: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #3a5263;
}

.screen .journal-footer {
    height: 44px;
    -unity-text-align: middle-center;
}

/* Preserve readable text and the 48-unit hit height inside a compact pane. */
.narrow-body .hud-objective {
    padding-left: 12px;
    padding-right: 12px;
}

.narrow-body .tile {
    width: 46%;
    max-width: 162px;
    padding-left: 8px;
    padding-right: 8px;
}

.narrow-body .wing {
    width: 88px;
}

.narrow-body .hud-title {
    font-size: 22px;
}

.narrow-body .status {
    width: 152px;
}

.narrow-body .quest-scroll {
    padding-left: 4px;
    padding-right: 4px;
}

.narrow-body .journal-header .title {
    font-size: 26px;
}

.small-pane .hud-title {
    position: absolute;
    left: 0;
    right: 0;
    width: auto;
}

.small-pane .status {
    margin-left: 2px;
    margin-right: 2px;
}

.small-pane .journal-header .title {
    font-size: 23px;
}
