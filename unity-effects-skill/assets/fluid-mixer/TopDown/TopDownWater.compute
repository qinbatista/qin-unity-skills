#pragma kernel ClearGrid
#pragma kernel AddImpulse
#pragma kernel StepGrid
#include "WaterDomain.hlsl"
Texture2D<float4> _Read;
RWTexture2D<float4> _Write;
int _Profile;
float _TimeStep, _Elapsed, _Drive, _WaveSpeed, _Drag;
float4 _Actor; // position XY and velocity XY, both local metres
float4 _Impulse; // position XY, height, radius
static const int2 Size=int2(128,72);
static const float Cell=.0625;

float2 Position(int2 i) { return ((float2(i)+.5)/Size-.5)*BasinSize; }
float4 Neighbour(int2 i,float4 center,float2 normal)
{
    if (all(i>=0) && all(i<Size))
    {
        if (WaterBoundary(Position(i),_Profile)>=0) center = _Read[i];
        else center.yz -= 2*normal*dot(center.yz,normal);
    }
    return center;
}
float Square(float x) { return x*x; }
float Hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return (x & 65535u)/65535.0;
}
[numthreads(8,8,1)]
void ClearGrid(uint3 id:SV_DispatchThreadID)
{
    _Write[id.xy]=0;
}
[numthreads(8,8,1)]
void AddImpulse(uint3 id:SV_DispatchThreadID)
{
    int2 i=id.xy;
    float2 p=Position(i);
    if (WaterBoundary(p,_Profile)<0) return;
    float2 q=p-_Impulse.xy;
    float4 state=_Write[i];
    state.x=clamp(state.x+_Impulse.z*exp(-dot(q,q)/(_Impulse.w*_Impulse.w)),-.42,.5);
    _Write[i]=state;
}
[numthreads(8,8,1)]
void StepGrid(uint3 id:SV_DispatchThreadID)
{
    int2 i=id.xy;
    float2 p=Position(i);
    if (WaterBoundary(p,_Profile)<0) { _Write[i]=0; return; }
    float dt=_TimeStep;
    float4 c=_Read[i], l=Neighbour(i+int2(-1,0),c,float2(1,0)), r=Neighbour(i+int2(1,0),c,float2(1,0));
    float4 b=Neighbour(i+int2(0,-1),c,float2(0,1)), t=Neighbour(i+int2(0,1),c,float2(0,1));
    float div=(r.y-l.y+t.z-b.z)/(.125);
    float2 grad=float2(r.x-l.x,t.x-b.x)/(.125);
    // First-order upwind flux for the transported momentum and surface tracer.
    float4 dx=c.y>=0 ? c-l : r-c;
    float4 dy=c.z>=0 ? c-b : t-c;
    float4 adv=(c.y*dx+c.z*dy)/Cell;
    // Rusanov viscosity for the gravity waves and upwind transport for the
    // current. The maximum two-axis Courant sum is below one at 120 Hz.
    float4 laplacian = l+r+b+t-4*c;
    float4 v = c-dt*adv;
    v.xyz += (.5*_WaveSpeed*dt/Cell)*laplacian.xyz;
    v.w += .005*laplacian.w;
    v.x-=dt*(.48*div+.22*c.x);
    v.yz-=dt*(_WaveSpeed*_WaveSpeed/.48*grad+_Drag*c.yz);
    v.w-=dt*.38*c.w;
    float2 force=0;
    float height=0, pigment=0;
    if (_Profile==0)
    {
        float speed=length(_Actor.zw);
        float2 axis=_Actor.zw/max(speed,.001);
        float2 q=p-_Actor.xy;
        float along=dot(q,axis), across=dot(q,float2(-axis.y,axis.x));
        float pressure=exp(-Square((along-.13)/.14)-Square(across/.105));
        float release=exp(-Square((along+.16)/.15)-Square(across/.14));
        height=2.2*speed*(pressure-release*.84);
        force=axis*(pressure+.23*release)*1.4*speed;
        pigment=4.5*release*speed;
    }
    else if (_Profile>=1 && _Profile<=3)
    {
        float side=_Profile==1 ? 0 : (_Profile==2 ? -1 : 1);
        float branch=_Profile==2 ? 1-smoothstep(-.15,.6,p.x) : smoothstep(-.7,.25,p.x);
        force=float2(1,side*branch*clamp(p.y*1.45,-.4,.4))*1.05;
        float sideAxis=_Profile==2 ? abs(p.y)-1.10 : p.y;
        float lane=.20+ .80*pow(.5+.5*sin(11.2*sideAxis+2.1*sin(.83*_Elapsed)),3);
        pigment=4*lane*exp(-Square((p.x+3.55)/.28))*(.59+.41*sin(_Elapsed*4));
    }
    else if (_Profile==4)
    {
        float2 q=p-float2(.10,-.09);
        float rad=max(length(q),.05);
        float2 outwards=q/rad;
        force=(-.56*outwards+float2(-outwards.y,outwards.x)*1.65)*exp(-.47*rad*rad);
        height=-.52*exp(-dot(q,q)/.19);
        float seedBand=exp(-Square((rad-1.08)/.24));
        float angle=atan2(q.y,q.x);
        float emission=.60+.40*cos(3.3*_Elapsed+2.2*angle);
        pigment=3.7*seedBand*pow(.5+.5*cos(angle*3.0),16)*emission;
    }
    else
    {
        // Each raindrop displaces water for 1/15 s, then the grid carries the wave.
        uint eventId=(uint)floor(_Elapsed*7.0);
        float age=frac(_Elapsed*7.0);
        float2 hit=float2(Hash(eventId*2+19),Hash(eventId*2+37));
        hit=(hit-.5)*float2(6.6,3.35);
        float qq=dot(p-hit,p-hit)/.015;
        float tap=sin(min(age*2,1)*3.14159)*step(age,.5);
        height=3.8*tap*(1-qq)*exp(-qq);
        pigment=1.0*tap*exp(-qq*2);
    }
    float gate=_Drive*smoothstep(0,.4,_Elapsed);
    v.yz+=dt*gate*force;
    v.x+=dt*gate*height;
    v.w+=dt*gate*pigment*(1-saturate(v.w));
    v.yz=clamp(v.yz,-1.45,1.45);
    v.x=clamp(v.x,-.42,.5);
    v.w=saturate(v.w);
    _Write[i]=v;
}
